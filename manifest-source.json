{
  "_comment": "Источник для manifest.json (моды, ModSync) и plugins.json (плагины, PluginSync). Редактируйте этот файл, CI соберёт и подпишет оба. {modsync}/{pixelui} — версии модов, {modgate}/{pixelui_paper}/{pluginsync}/{pixelauth} — версии плагинов из build.gradle.kts. Внешний плагин: {\"name\": имя из plugin.yml, \"version\", \"url\": https-ссылка на jar}.",
  "siteUrl": "https://yeamu.my.id",
  "minecraft": "1.21.11",
  "modsyncMinVersion": "1.1.1",
